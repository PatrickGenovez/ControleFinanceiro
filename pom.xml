<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    
    <!-- 1. O PARENT: Diz que nosso projeto é filho do Spring Boot (ele gerencia as versões pra nós) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <!-- 2. IDENTIFICAÇÃO DO SEU PROJETO -->
    <groupId>br.com.devpatrick</groupId>
    <artifactId>ControleFinanceiro</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ControleFinanceiro</name>
    <description>Projeto de Controle Financeiro com Spring Boot e JPA</description>

    <!-- 3. VERSÃO DO JAVA -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- 4. LISTA DE COMPRAS (DEPENDÊNCIAS): O que o Maven vai baixar -->
    <dependencies>
        <!-- Traz o Spring Data JPA + Hibernate (elimina o SQL manual) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver MySQL (substitui o .jar que estava na pasta lib) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <!-- 5. O PLUGIN DO SPRING: Permite empacotar e rodar a aplicação -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
